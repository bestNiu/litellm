LITELLM_MASTER_KEY=sk-change-me
LITELLM_SALT_KEY=change-me-to-a-random-hex-string

POSTGRES_USER=aigateway
POSTGRES_PASSWORD=change-me
POSTGRES_DB=litellm
POSTGRES_HOST=your-rds-host.pg.rds.aliyuncs.com

# 上游 LLM Provider API Keys（按需填写后 docker compose restart unionlab-gateway）
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DASHSCOPE_API_KEY=
# 阿里百炼国内 Key 需配置国内图片生成 endpoint
DASHSCOPE_API_BASE_IMAGE=https://dashscope.aliyuncs.com/api/v1/services/aigc/multimodal-generation/generation
DASHSCOPE_API_BASE_RERANK=https://dashscope.aliyuncs.com/compatible-api/v1/reranks

# Azure AI Foundry 资源级 endpoint（https://<resource>.services.ai.azure.com）
# 勿使用 /api/projects/... 项目路径，会导致 API version not supported
AZURE_AI_API_BASE=
AZURE_AI_API_KEY=
